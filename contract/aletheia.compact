pragma language_version >= 0.23;

import CompactStandardLibrary;

// Aletheia — provenance without identity. Draft surface.

export ledger manufacturerRoots: Set<Bytes<32>>;
export ledger revokedCerts: Set<Bytes<32>>;
export ledger submissions: Set<Bytes<32>>;
export ledger submissionCount: Counter;
export ledger juryThreshold: Uint<8>;

witness sourceSecret(): Bytes<32>;
witness certRoot(): Bytes<32>;
witness certFingerprint(): Bytes<32>;
witness gpsTile(): Bytes<32>;
witness captureEpoch(): Uint<32>;

circuit submissionNullifier(mediaHash: Bytes<32>, sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>(
    [pad(32, "alt:sub:v1"), mediaHash, sk]
  );
}

constructor(threshold: Uint<8>) {
  juryThreshold = disclose(threshold);
}

// Publish a predicate over a C2PA manifest without publishing the manifest.
// regionId and periodYear are the source's chosen disclosure granularity.
export circuit submit(
  mediaHash: Bytes<32>,
  regionId: Bytes<32>,
  periodYear: Uint<16>,
  ciphertextCommit: Bytes<32>
): [] {
  assert(manufacturerRoots.member(disclose(certRoot())), "unknown manufacturer");
  assert(!revokedCerts.member(disclose(certFingerprint())), "certificate revoked");

  const year = captureEpoch() / (31536000 as Uint<32>) + (1970 as Uint<32>);
  assert((year as Uint<16>) == disclose(periodYear), "period claim mismatch");

  const n = submissionNullifier(disclose(mediaHash), sourceSecret());
  assert(!submissions.member(disclose(n)), "already submitted");
  submissions.insert(disclose(n));
  submissionCount.increment(1);
}
